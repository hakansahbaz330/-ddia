# Kopyalayın: cp .env.example .env   (.env dosyasını Git'e eklemeyin)

# Yerel prototip: SQLite. Üretim: PostgreSQL, örn.
# DATABASE_URL=postgresql+psycopg://kullanici:parola@localhost:5432/futbol
DATABASE_URL=sqlite:///./data/football.sqlite

# Yüklenen arşivlerin geçici saklandığı klasör
UPLOAD_DIR=./data/uploads

# Boş bırakılırsa API herkese açıktır (yalnızca yerel kullanım). Doluysa
# değiştirici isteklerde "X-API-Key" başlığı zorunludur.
API_KEY=

# Faz 6 (canlı fikstür/oran) için; şimdilik kullanılmıyor. Gerçek anahtarı yalnızca .env'e yazın.
ODDS_API_KEY=
API_FOOTBALL_KEY=
